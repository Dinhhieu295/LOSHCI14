NODE_ENV=development
HOST=127.0.0.1
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string. Start the local database with `docker compose up -d db`.
DATABASE_URL=postgresql://lifeos:lifeos@127.0.0.1:5432/lifeos

# Required outside local development. Use a long random value.
SESSION_TTL_DAYS=30

# Optional. Enable the LifeOS assistant with an OpenAI API project key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional. Enable an Ollama endpoint controlled by the backend operator.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Stable server-only secret (at least 32 characters) for encrypting personal AI keys.
ASSISTANT_SETTINGS_KEY=
